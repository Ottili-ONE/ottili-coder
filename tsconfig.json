{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@ottili/protocol": ["packages/protocol/src/index.ts"],
      "@ottili/core": ["packages/core/src/index.ts"],
      "@ottili/control-plane": ["packages/control-plane/src/index.ts"],
      "@ottili/runtime": ["packages/runtime/src/index.ts"],
      "@ottili/agents": ["packages/agents/src/index.ts"],
      "@ottili/validation": ["packages/validation/src/index.ts"],
      "@ottili/recovery": ["packages/recovery/src/index.ts"],
      "@ottili/context": ["packages/context/src/index.ts"],
      "@ottili/context-format": ["packages/context-format/src/index.ts"],
      "@ottili/workspace": ["packages/workspace/src/index.ts"],
      "@ottili/server": ["packages/server/src/index.ts"],
      "@ottili/integrations": ["packages/integrations/src/index.ts"],
      "@ottili/sdk": ["packages/sdk/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/dist/**", "node_modules", "tests/fixtures/realistic-repo/**"]
}
